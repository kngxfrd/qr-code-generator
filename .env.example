# Copy this file to .env and supply your own credentials.
# The Google OAuth callback URI must be registered with Google as:
# http://127.0.0.1:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
PUBLIC_ORIGIN=http://127.0.0.1:3000
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
# Set true only behind a trusted Cloudflare proxy that overwrites CF-IPCountry.
TRUST_PROXY_COUNTRY_HEADER=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
PAYSTACK_USD_TO_LOCAL_RATE=15
