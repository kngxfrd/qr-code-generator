# Copy this file to .env and supply your own credentials.
# The Google OAuth callback URI must be registered with Google as:
# http://127.0.0.1:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Direct public origin used inside dynamic QR codes. In production, set this to the Django/Render backend URL.
QR_REDIRECT_ORIGIN=http://127.0.0.1:8000
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
# Set true only behind a trusted Cloudflare proxy that overwrites CF-IPCountry.
TRUST_PROXY_COUNTRY_HEADER=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
PAYSTACK_USD_TO_LOCAL_RATE=15
# Contact form mail delivery (SMTP credentials belong in the backend environment, not the frontend).
SUPPORT_EMAIL=support.togethere@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sending-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Free QR Generator <your-sending-gmail-address@gmail.com>
